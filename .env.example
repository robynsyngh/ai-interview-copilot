# =============================================================================
# AI Interview Co-Pilot — root .env.example
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# Never commit real secrets.
# =============================================================================

# ---- Postgres (used by docker-compose and the FastAPI backend) ----
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev_password
POSTGRES_DB=copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full DSN consumed by FastAPI / SQLModel (constructed for in-container use).
# When running the API on the host instead of docker, swap `postgres` for `localhost`.
DATABASE_URL=postgresql+psycopg://copilot:copilot_dev_password@postgres:5432/copilot

# ---- pgAdmin ----
PGADMIN_DEFAULT_EMAIL=admin@copilot.dev
PGADMIN_DEFAULT_PASSWORD=admin

# ---- FastAPI backend ----
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,chrome-extension://*
LOG_LEVEL=INFO

# ---- External AI services (placeholders only — fill in when you have keys) ----
# Deepgram Nova-2 streaming transcription
DEEPGRAM_API_KEY=your-deepgram-api-key-here
DEEPGRAM_MODEL=nova-2

# GitHub Models inference (uses a GitHub PAT with `models:read`)
GITHUB_MODELS_TOKEN=your-github-pat-here
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com
GITHUB_MODELS_NAME=gpt-4o-mini

# Google Gemini — automatic fallback when GitHub Models is rate limited.
# Get a free key at https://aistudio.google.com/apikey (leave blank to disable).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# Order LLM providers are tried in (first wins, rest are failover): github,gemini
MODEL_PROVIDER_ORDER=github,gemini

# ---- Next.js frontend ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
