#!/usr/bin/env bash
#
# commit-msg: enforce Conventional Commits so history stays readable.
#   <type>(<optional scope>)<optional !>: <subject>
#
#   feat:        a new feature
#   fix:         a bug fix
#   docs:        documentation only
#   style:       formatting, no code change
#   refactor:    code change that neither fixes a bug nor adds a feature
#   perf:        performance improvement
#   test:        adding/fixing tests
#   build:       build system or dependencies
#   ci:          CI configuration
#   chore:       maintenance
#   revert:      reverts a previous commit
#
# Examples:
#   feat(web): add reduced-motion support to animations
#   fix(api): persist pasted question before generating hint
#   chore: bump ruff to 0.7

set -uo pipefail

MSG_FILE="$1"
# First non-empty, non-comment line is the subject/header.
HEADER="$(grep -vE '^\s*#' "$MSG_FILE" | sed '/^\s*$/d' | head -n 1)"

RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'; NC=$'\033[0m'

# Allow merge/revert/fixup/squash autogenerated messages through.
if printf "%s" "$HEADER" | grep -Eq '^(Merge |Revert "|fixup! |squash! )'; then
  exit 0
fi

TYPES='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
PATTERN="^(${TYPES})(\([a-z0-9._/-]+\))?!?: .+"

if ! printf "%s" "$HEADER" | grep -Eq "$PATTERN"; then
  echo "${RED}✗ Invalid commit message.${NC}"
  echo "  Got:      ${YELLOW}${HEADER}${NC}"
  echo "  Expected: ${GREEN}<type>(<scope>): <subject>${NC}"
  echo "  Types:    ${TYPES//|/, }"
  echo "  Example:  ${GREEN}feat(web): add active-route highlight to nav${NC}"
  exit 1
fi

# Header length guard (conventional-commits recommends <= 72; cap hard at 100).
if [ "${#HEADER}" -gt 100 ]; then
  echo "${RED}✗ Commit subject is too long (${#HEADER} chars). Keep it under 100.${NC}"
  exit 1
fi

exit 0
